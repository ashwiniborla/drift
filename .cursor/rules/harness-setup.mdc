  bash scripts/agent/confluence.sh test-auth   # fail → confluence.sh setup

grep -q "jira-epic:" harness-state.md 2>/dev/null && \
  bash scripts/agent/jira.sh test-auth         # fail → jira.sh setup

grep -q "github-integration: ENABLED" harness-state.md 2>/dev/null && \
  bash scripts/agent/github.sh test-auth       # fail → github.sh setup

grep -q "sonar-project-key:" harness-state.md 2>/dev/null && \
  # Dispatch sonar-agent SETUP_AUTH — verifies credentials, prompts setup if stale
```

On any auth failure: prompt `! bash scripts/agent/<script> setup` and STOP — do not advance past scaffold gate.

