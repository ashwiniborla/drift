# Drift local development environment variables
# Copy this file to .env and fill in actual values.
# The .env file is gitignored — never commit secrets.

# ─── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_FRONTEND=localhost:7233
TEMPORAL_TASK_QUEUE=drift-task-queue

# ─── HBase ────────────────────────────────────────────────────────────────────
# Path to your local hbase-site.xml (pointing to staging HBase)
HBASE_CONFIG_BUCKET=/Users/nidhi.b/.drift/config/hbase-site.xml

# ─── Hadoop identity ──────────────────────────────────────────────────────────
HADOOP_USERNAME=nidhi.b
HADOOP_LOGIN_USER=nidhi.b

# ─── Redis Sentinel ────────────────────────────────────────────────────────────
# Format: masterName for Jedis sentinel pool
REDIS_MASTER=mymaster
# Comma-separated list of sentinel host:port
REDIS_SENTINELS=localhost:26379
# Unique prefix for local dev (avoids colliding with staging data)
REDIS_PREFIX=drift-local-dev-
# Leave empty if no password
REDIS_PASSWORD=

# ─── Config buckets ────────────────────────────────────────────────────────────
# For local dev, create empty files: mkdir -p /tmp/drift-config && touch /tmp/drift-config/*.properties
AUTH_PATH=/tmp/drift-config/auth.properties
AB_CONFIG_BUCKET=/tmp/drift-config/ab.properties
WORKFLOW_PROPERTY_PATH=/tmp/drift-config/workflow.properties
ENUM_STORE_BUCKET=/tmp/drift-config/enum.properties

# ─── JVM sizing ───────────────────────────────────────────────────────────────
JVM_XMS=256m
JVM_XMX=1g
