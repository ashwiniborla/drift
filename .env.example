# .env.example — Drift local development environment variables
# Copy to .env and fill in values before running boot.sh
# cp .env.example .env

# ─── Redis Sentinel ───────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_MASTER=mymaster
REDIS_SENTINELS=localhost:26379
REDIS_PREFIX=drift:

# ─── HBase ────────────────────────────────────────────────────────────────
# URL to an HBase properties file. For local dev, run a simple HTTP server:
#   python3 -m http.server 9999 --directory /path/to/hbase-props/
# and create hbase-local.properties with:
#   hbase.zookeeper.quorum=localhost
#   hbase.zookeeper.property.clientPort=2181
HBASE_CONFIG_BUCKET=http://localhost:9999/hbase-local.properties
HADOOP_USERNAME=hadoop
HADOOP_LOGIN_USER=hadoop

# ─── Temporal ─────────────────────────────────────────────────────────────
TEMPORAL_FRONTEND=localhost:7233
TEMPORAL_TASK_QUEUE=drift-task-queue

# ─── JVM Settings ─────────────────────────────────────────────────────────
JVM_XMS=512m
JVM_XMX=1g

# ─── Worker-only settings ─────────────────────────────────────────────────
# These can point to static files served over HTTP for local dev.
# Use a mock HTTP server (e.g., WireMock, python3 http.server) to serve them.
ENUM_STORE_BUCKET=http://localhost:9999/lookup.properties
AB_CONFIG_BUCKET=http://localhost:9999/ab.properties
AUTH_PATH=http://localhost:9999/auth.properties
WORKFLOW_PROPERTY_PATH=http://localhost:9999/workflow.properties
